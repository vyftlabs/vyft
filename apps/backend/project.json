{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vyft/backend",
  "projectType": "application",
  "implicitDependencies": ["web"],
  "sourceRoot": "apps/backend",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go tool air -c .air.toml",
        "cwd": "apps/backend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "web",
          "target": "build"
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf ./internal/server/static/dist",
          "mkdir -p ./internal/server/static/dist",
          "cp -R ../../apps/web/dist/. ./internal/server/static/dist/",
          "go build -o ./dist/backend ./cmd/backend"
        ],
        "cwd": "apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "apps/backend"
      }
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/sqlc.yaml",
        "{projectRoot}/internal/db/queries/**/*.sql",
        "{projectRoot}/internal/db/migrations/**/*.sql"
      ],
      "options": {
        "command": "sqlc generate",
        "cwd": "apps/backend"
      }
    },
    "api:generate": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/oapi-codegen.yaml",
        "{workspaceRoot}/packages/spec/dist/openapi.yaml"
      ],
      "options": {
        "command": "go tool oapi-codegen -config oapi-codegen.yaml ../../packages/spec/dist/openapi.yaml && go fmt ./internal/openapi/...",
        "cwd": "apps/backend"
      }
    }
  }
}
