{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@vyft/backend",
  "projectType": "application",
  "implicitDependencies": ["web"],
  "sourceRoot": "apps/backend",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "air -c .air.toml",
        "cwd": "apps/backend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "web",
          "target": "build"
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf ./internal/server/static/dist",
          "mkdir -p ./internal/server/static/dist",
          "cp -R ../../apps/web/dist/. ./internal/server/static/dist/",
          "go build -o ./dist/backend ./cmd/backend"
        ],
        "cwd": "apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "apps/backend"
      }
    }
  }
}
