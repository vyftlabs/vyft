---
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Vyft — infrastructure as code for TypeScript. Deploy, scale, and manage infrastructure directly from TypeScript."
		/>
		<title>Vyft — Infrastructure as Code for TypeScript</title>
	</head>
	<body>
		<!-- Nav -->
		<header
			style="border-bottom: 1px solid var(--color-border); background: rgba(9,9,11,0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
			class="fixed top-0 left-0 right-0 z-50"
		>
			<nav
				class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
			>
				<a
					href="/"
					class="text-base font-semibold tracking-tight"
					style="color: var(--color-text);"
				>
					vyft
				</a>
				<div class="flex items-center gap-6">
					<a
						href="https://github.com/vyftlabs/vyft"
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 text-sm transition-colors duration-150"
						style="color: var(--color-muted);"
						onmouseover="this.style.color='var(--color-text)'"
						onmouseout="this.style.color='var(--color-muted)'"
					>
						<svg
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
							></path>
						</svg>
						GitHub
					</a>
					<a
						href="/docs"
						class="text-sm transition-colors duration-150"
						style="color: var(--color-muted);"
						onmouseover="this.style.color='var(--color-text)'"
						onmouseout="this.style.color='var(--color-muted)'"
					>
						Docs
					</a>
				</div>
			</nav>
		</header>

		<!-- Hero -->
		<main>
			<section
				class="relative flex min-h-screen flex-col items-center justify-center px-6 text-center"
			>
				<!-- Ambient glow -->
				<div
					aria-hidden="true"
					style="position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 80% 50% at 50% 20%, rgba(124,58,237,0.08) 0%, transparent 70%);"
				>
				</div>

				<div class="relative z-10 max-w-3xl">
					<!-- Badge -->
					<div class="mb-8 flex justify-center">
						<span
							class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium"
							style="background: rgba(124,58,237,0.1); color: var(--color-accent-light); border: 1px solid rgba(124,58,237,0.25); font-family: var(--font-mono);"
						>
							<span
								class="inline-block h-1.5 w-1.5 rounded-full"
								style="background: var(--color-accent-light);"></span>
							Open Source
						</span>
					</div>

					<!-- Headline -->
					<h1
						class="mb-6 text-5xl font-bold leading-tight tracking-tight sm:text-6xl lg:text-7xl"
						style="color: var(--color-text);"
					>
						Infrastructure as code<br />
						<span style="color: var(--color-accent-light);">for TypeScript.</span>
					</h1>

					<!-- Subtext -->
					<p
						class="mx-auto mb-10 max-w-xl text-lg leading-relaxed sm:text-xl"
						style="color: var(--color-muted);"
					>
						Deploy, scale, and manage infrastructure directly from TypeScript —
						no YAML, no cloud console, no config drift.
					</p>

					<!-- CTAs -->
					<div
						class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center"
					>
						<a
							href="https://github.com/vyftlabs/vyft"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-all duration-150"
							style="background: var(--color-accent); color: #fff;"
							onmouseover="this.style.background='#6d28d9'"
							onmouseout="this.style.background='var(--color-accent)'"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path
									d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
								></path>
							</svg>
							View on GitHub
						</a>
						<a
							href="/docs"
							class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-all duration-150"
							style="background: transparent; color: var(--color-text); border: 1px solid var(--color-border);"
							onmouseover="this.style.borderColor='var(--color-accent-light)'; this.style.color='var(--color-accent-light)'"
							onmouseout="this.style.borderColor='var(--color-border)'; this.style.color='var(--color-text)'"
						>
							Read the docs
							<svg
								width="14"
								height="14"
								viewBox="0 0 16 16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								aria-hidden="true"
							>
								<path
									d="M3 8h10M9 4l4 4-4 4"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</a>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer
			style="border-top: 1px solid var(--color-border);"
			class="px-6 py-8"
		>
			<div
				class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 text-sm sm:flex-row"
				style="color: var(--color-muted);"
			>
				<span>© {new Date().getFullYear()} Vyft</span>
				<div class="flex items-center gap-6">
					<a
						href="https://github.com/vyftlabs/vyft"
						target="_blank"
						rel="noopener noreferrer"
						class="transition-colors duration-150"
						style="color: var(--color-muted);"
						onmouseover="this.style.color='var(--color-text)'"
						onmouseout="this.style.color='var(--color-muted)'"
					>
						GitHub
					</a>
					<a
						href="/docs"
						class="transition-colors duration-150"
						style="color: var(--color-muted);"
						onmouseover="this.style.color='var(--color-text)'"
						onmouseout="this.style.color='var(--color-muted)'"
					>
						Docs
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
