---
import "../styles/global.css";

const logo =
  "M10.4916 3.47575C7.87926 5.50306 4.39535 11.0053 2.65381 15.3497C-0.829266 24.9066 -0.829244 73.2714 2.3633 121.925C4.39537 150.886 5.84718 157.546 13.1039 170.579C17.4585 179.267 26.7481 190.272 33.134 195.486C39.5208 200.698 93.2237 229.079 152.732 258.909C256.075 310.749 275.524 322.333 275.524 333.628C275.524 341.448 250.269 356.797 149.829 409.505C32.2633 471.769 22.1029 478.723 8.75002 506.814C1.49251 522.16 1.20281 524.771 0.331213 588.776C-0.539557 634.241 0.331212 657.7 2.65381 663.201C7.00848 673.629 17.168 678.26 28.7802 674.787C39.5208 671.601 178.278 599.779 466.825 448.022C538.528 410.374 557.104 388.364 559.425 338.841C562.042 284.685 543.458 256.592 486.273 227.922C209.919 89.7789 27.0378 0 21.8132 0C18.3293 0 13.1039 1.73829 10.4916 3.47575Z";

// What you can deploy: the primitives, persona-A framing (no infra jargon).
const primitives = [
  {
    title: "Apps & services",
    body: "Deploy any app or API from a container image. Set the port, scale the instances, add health checks.",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" />`,
  },
  {
    title: "Databases",
    body: "Run Postgres, Redis, and more right next to your apps, with persistent disks that survive restarts.",
    icon: `<ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0" />`,
  },
  {
    title: "Static sites",
    body: "Host front-ends and static sites on a custom domain, with automatic TLS out of the box.",
    icon: `<circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15 15 0 0 1 0 20a15 15 0 0 1 0-20" />`,
  },
  {
    title: "Jobs & workers",
    body: "Run background workers and scheduled cron jobs on the same platform as everything else.",
    icon: `<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />`,
  },
  {
    title: "Env & secrets",
    body: "Manage environment variables once and share them across services. Link apps to their databases.",
    icon: `<circle cx="8" cy="15" r="4" /><path d="M10.85 12.15 19 4M18 5l2 2M15 8l2 2" />`,
  },
  {
    title: "Custom domains",
    body: "Point a domain, get HTTPS automatically, and route traffic to the right service.",
    icon: `<path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" /><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" />`,
  },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#252525" />
		<meta
			name="description"
			content="Vyft is an open-source, self-hosted PaaS, a simpler alternative to Heroku and Railway. Deploy apps, databases, and sites to infrastructure you own. Built to scale when you do."
		/>
		<meta property="og:title" content="Vyft: Self-host your apps, the simple way" />
		<meta property="og:description" content="An open-source platform for deploying apps, databases, and sites to infrastructure you own. A clean dashboard, push-to-deploy, built to scale when you do." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://vyft.dev" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="Vyft: Self-host your apps, the simple way" />
		<meta name="twitter:description" content="An open-source platform for deploying apps, databases, and sites to infrastructure you own. A clean dashboard, push-to-deploy, built to scale when you do." />
		<title>Vyft: Self-host your apps · Open-source PaaS</title>
	</head>
	<body>
		<!-- Vertical rail lines -->
		<div class="grid-frame" aria-hidden="true"></div>

		<!-- ─── Nav ─────────────────────────────────────────────────── -->
		<header
			class="fixed top-0 left-0 right-0 z-50"
			style="background: oklch(0.145 0 0 / 0.8); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--color-border);"
		>
			<nav class="relative z-10 mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
				<a href="/" class="nav-link flex items-center gap-2.5">
					<svg height="22" viewBox="0 0 560 676" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d={logo} fill="currentColor" />
					</svg>
					<span class="text-base font-bold tracking-tight">vyft</span>
				</a>
				<div class="flex items-center gap-5">
					<a
						href="/docs"
						class="nav-link-muted py-2 px-1 text-sm transition-colors duration-150"
					>
						Docs
					</a>
					<a
						href="https://github.com/vyftlabs/vyft"
						target="_blank"
						rel="noopener noreferrer"
						class="nav-link-muted flex items-center gap-1.5 py-2 px-1 text-sm transition-colors duration-150"
					>
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
						</svg>
						GitHub
					</a>
				</div>
			</nav>
		</header>

		<main>
			<!-- ─── Hero ────────────────────────────────────────────── -->
			<section class="relative z-10 flex flex-col items-center justify-center overflow-hidden px-6 pt-44 pb-32 text-center">
				<div
					class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-[600px] w-[800px]"
					style="background: radial-gradient(ellipse at center, oklch(0.3 0 0 / 0.4) 0%, transparent 70%);"
					aria-hidden="true"
				></div>

				<div class="relative max-w-3xl">
					<h1
						class="mb-6 text-5xl font-bold leading-[1.08] sm:text-6xl lg:text-7xl"
						style="color: var(--color-text); letter-spacing: -0.04em;"
					>
						Self-host your apps,<br />the simple way.
					</h1>

					<p
						class="mx-auto mb-10 max-w-xl text-base leading-relaxed sm:text-lg"
						style="color: var(--color-muted);"
					>
						Vyft is an open-source platform for deploying apps, databases, and sites to infrastructure you own. A clean dashboard, push-to-deploy, built to scale when you do.
					</p>

					<div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
						<a
							href="/docs"
							class="btn-primary inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-colors duration-150"
						>
							Get Started
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
						<a
							href="https://github.com/vyftlabs/vyft"
							target="_blank"
							rel="noopener noreferrer"
							class="btn-ghost inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-colors duration-150"
						>
							View on GitHub
						</a>
					</div>

					<p
						class="mt-8 text-xs"
						style="color: var(--color-muted); font-family: var(--font-mono);"
					>
						Open source · Deploy in minutes · Scales with you
					</p>
				</div>
			</section>

			<!-- ─── What you can deploy ─────────────────────────────── -->
			<section class="section-rule relative z-10">
				<div class="mx-auto max-w-5xl px-6 py-32">
					<div class="mb-14 max-w-2xl">
						<p
							class="mb-3 text-xs font-medium uppercase tracking-widest"
							style="color: var(--color-muted); font-family: var(--font-mono);"
						>
							Everything your app needs
						</p>
						<h2
							class="text-3xl font-bold sm:text-4xl"
							style="color: var(--color-text); letter-spacing: -0.03em;"
						>
							One platform for your whole stack.
						</h2>
					</div>

					<div class="primitive-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
						{primitives.map((p) => (
							<div class="primitive-cell">
								<div
									class="mb-4 flex h-9 w-9 items-center justify-center rounded-md"
									style="background: oklch(1 0 0 / 5%); border: 1px solid var(--color-border);"
								>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-text)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
								</div>
								<h3 class="mb-1.5 text-sm font-semibold" style="color: var(--color-text);">
									{p.title}
								</h3>
								<p class="text-sm leading-relaxed" style="color: var(--color-muted);">
									{p.body}
								</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- ─── The wedge: built to scale ───────────────────────── -->
			<section class="section-rule relative z-10">
				<div class="mx-auto max-w-5xl px-6 py-32">
					<div class="flex flex-col items-start gap-14 lg:flex-row lg:items-center">
						<div class="flex-1">
							<p
								class="mb-3 text-xs font-medium uppercase tracking-widest"
								style="color: var(--color-muted); font-family: var(--font-mono);"
							>
								Built to scale
							</p>
							<h2
								class="mb-4 text-3xl font-bold sm:text-4xl"
								style="color: var(--color-text); letter-spacing: -0.03em;"
							>
								Start simple.<br />Never re-platform.
							</h2>
							<p
								class="max-w-md text-sm leading-relaxed sm:text-base"
								style="color: var(--color-muted);"
							>
								Most platforms are easy until you outgrow them, then you rebuild everything on "real" infrastructure. Vyft starts you on the real thing, kept simple. When you grow, you scale up. You never start over.
							</p>
						</div>

						<div class="w-full flex-shrink-0 lg:w-80">
							<div class="scale-steps flex flex-col">
								<div class="scale-step flex items-start gap-3 p-5">
									<span class="mt-0.5 text-xs font-semibold" style="color: var(--color-muted); font-family: var(--font-mono);">01</span>
									<div>
										<h3 class="mb-1 text-sm font-semibold" style="color: var(--color-text);">Ship in minutes</h3>
										<p class="text-sm leading-relaxed" style="color: var(--color-muted);">Deploy your first app from the dashboard, no setup ceremony.</p>
									</div>
								</div>
								<div class="scale-step flex items-start gap-3 p-5">
									<span class="mt-0.5 text-xs font-semibold" style="color: var(--color-muted); font-family: var(--font-mono);">02</span>
									<div>
										<h3 class="mb-1 text-sm font-semibold" style="color: var(--color-text);">Grow without limits</h3>
										<p class="text-sm leading-relaxed" style="color: var(--color-muted);">Add services, scale instances, and span servers as traffic climbs.</p>
									</div>
								</div>
								<div class="scale-step flex items-start gap-3 p-5">
									<span class="mt-0.5 text-xs font-semibold" style="color: var(--color-muted); font-family: var(--font-mono);">03</span>
									<div>
										<h3 class="mb-1 text-sm font-semibold" style="color: var(--color-text);">Keep control</h3>
										<p class="text-sm leading-relaxed" style="color: var(--color-muted);">It's your infrastructure and standard underneath, yours to take over anytime.</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ─── Self-host (open source) ─────────────────────────── -->
			<section class="section-rule relative z-10">
				<div class="mx-auto max-w-5xl px-6 py-32">
					<div class="mb-8 max-w-2xl">
						<p
							class="mb-3 text-xs font-medium uppercase tracking-widest"
							style="color: var(--color-muted); font-family: var(--font-mono);"
						>
							Open source
						</p>
						<h2
							class="text-3xl font-bold sm:text-4xl"
							style="color: var(--color-text); letter-spacing: -0.03em;"
						>
							Free to run. Yours to own.
						</h2>
					</div>

					<div class="flex flex-col items-start gap-10 lg:flex-row lg:items-start">
						<div class="flex-1">
							<p
								class="max-w-md text-sm leading-relaxed sm:text-base"
								style="color: var(--color-muted);"
							>
								Install Vyft on your own cluster and own every byte. Free and open source, no seats, no lock-in. It's your infrastructure, and standard underneath. Up and running in one command.
							</p>
						</div>

						<div
							class="w-full flex-shrink-0 overflow-x-auto rounded-md p-4 text-xs leading-relaxed lg:w-96"
							style="background: var(--color-surface); border: 1px solid var(--color-border); font-family: var(--font-mono); color: var(--color-text);"
						>
							<div>helm repo add vyft https://charts.vyft.dev</div>
							<div>helm install vyft vyft/vyft \</div>
							<div>&nbsp;&nbsp;-n vyft --create-namespace</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ─── Final CTA ───────────────────────────────────────── -->
			<section class="section-rule relative z-10">
				<div class="mx-auto max-w-5xl px-6 py-36 text-center">
					<h2
						class="mb-4 text-3xl font-bold sm:text-4xl"
						style="color: var(--color-text); letter-spacing: -0.03em;"
					>
						Deploy your first app today.
					</h2>
					<p
						class="mx-auto mb-10 max-w-md text-sm leading-relaxed sm:text-base"
						style="color: var(--color-muted);"
					>
						Open source, self-hostable, and free to start. Spin it up on your own infrastructure in minutes.
					</p>
					<div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
						<a
							href="/docs"
							class="btn-primary inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-colors duration-150"
						>
							Get Started
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
						<a
							href="https://github.com/vyftlabs/vyft"
							target="_blank"
							rel="noopener noreferrer"
							class="btn-ghost inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-colors duration-150"
						>
							View on GitHub
						</a>
					</div>
				</div>
			</section>
		</main>

		<!-- ─── Footer ──────────────────────────────────────────────── -->
		<footer class="section-rule relative z-10">
			<div class="mx-auto max-w-5xl px-6 py-8">
				<div
					class="flex flex-col items-center justify-between gap-4 text-sm sm:flex-row"
					style="color: var(--color-muted);"
				>
					<div class="flex items-center gap-2">
						<svg height="14" viewBox="0 0 560 676" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d={logo} fill="currentColor" />
						</svg>
						<span>&copy; {new Date().getFullYear()} Vyft</span>
					</div>
					<div class="flex items-center gap-5">
						<a href="https://github.com/vyftlabs/vyft" target="_blank" rel="noopener noreferrer" class="footer-link transition-colors duration-150">GitHub</a>
						<a href="/docs" class="footer-link transition-colors duration-150">Docs</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	/* Bordered grid with internal dividers only — no outer frame.
	   Real borders (no background bleed), edges stripped per breakpoint
	   so it stays crisp at every width. Full grid (6 cells) at each col count. */
	.primitive-cell {
		/* 1 col: full-width rows, so text sits flush to both section edges */
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--color-border);
	}
	.primitive-cell:last-child {
		border-bottom: 0;
	}

	@media (min-width: 640px) {
		.primitive-cell {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
			border-right: 1px solid var(--color-border);
			border-bottom: 1px solid var(--color-border);
		}
		.primitive-cell:nth-child(2n + 1) {
			padding-left: 0; /* first column: flush left */
		}
		.primitive-cell:nth-child(2n) {
			padding-right: 0; /* last column: flush right */
			border-right: 0;
		}
		.primitive-cell:nth-last-child(-n + 2) {
			border-bottom: 0;
		}
	}

	@media (min-width: 1024px) {
		.primitive-cell {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
			border-right: 1px solid var(--color-border);
			border-bottom: 1px solid var(--color-border);
		}
		/* reset the 2-col edges, then apply 3-col edges */
		.primitive-cell:nth-child(2n + 1) {
			padding-left: 1.5rem;
		}
		.primitive-cell:nth-child(2n) {
			padding-right: 1.5rem;
			border-right: 1px solid var(--color-border);
		}
		.primitive-cell:nth-child(3n + 1) {
			padding-left: 0; /* first column: flush left */
		}
		.primitive-cell:nth-child(3n) {
			padding-right: 0; /* last column: flush right */
			border-right: 0;
		}
		.primitive-cell:nth-last-child(-n + 3) {
			border-bottom: 0;
		}
	}

	/* Vertical step list — dividers between, no outer border. */
	.scale-step {
		border-bottom: 1px solid var(--color-border);
	}
	.scale-step:last-child {
		border-bottom: 0;
	}
</style>
